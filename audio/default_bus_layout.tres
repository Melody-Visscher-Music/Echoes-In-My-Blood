[gd_resource type="AudioBusLayout" format=3]

; Master -> everything. Music and SFX both route into it, so the Master slider
; in Options stays the single "turn the game down" control, and the two child
; buses let the player balance the song against the hit/miss feedback.
; Before this split, the miss thunk and the song shared Master and there was no
; way to quiet one without muting the other.

[resource]
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
